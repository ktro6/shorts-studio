{
  "name": "shorts-studio-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Estúdio integrado para criação autônoma de vídeos 3D explicativos e curtas animados com Agentes de IA: motor Three.js procedural, síntese de voz (Kokoro/ElevenLabs), legendas dinâmicas, áudio DSP e renderizador Puppeteer + ffmpeg.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preview": "node tools/serve.mjs",
    "catalog": "node tools/build-catalog.mjs",
    "check": "node tools/check.mjs",
    "voz": "node tools/voz.mjs",
    "novo": "node tools/novo-projeto.mjs",
    "validar": "node tools/validar.mjs",
    "render": "node tools/render.mjs",
    "mix": "python tools/audio-dsp/mix.py",
    "empacotar": "node tools/empacotar.mjs",
    "beanmen:make": "npm --prefix beanmen run make",
    "beanmen:studio": "npm --prefix beanmen run studio",
    "beanmen:assets": "python beanmen/scripts/gen_audio_assets.py",
    "beanmen:locations": "npm --prefix beanmen run locations"
  },
  "dependencies": {
    "puppeteer-core": "^25.16.0",
    "three": "^0.187.0"
  }
}
